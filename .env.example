# Web3Forms Configuration (Get your instant free access key at https://web3forms.com)
# Enter your email on web3forms.com and paste the generated access key below:
VITE_WEB3FORMS_ACCESS_KEY=

# Formspree Alternative (optional: https://formspree.io/f/your_form_id)
VITE_FORMSPREE_ID=

# EmailJS Configuration (optional fallback)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# GitHub Personal Access Token (optional, for GitHub API rate limits)
VITE_GH_TOKEN=
